<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 允许明文流量（本地回环 / 调试用），线上大模型走 https 不受影响 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
